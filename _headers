# Cabeçalhos de segurança HTTP — reconhecido automaticamente pelo Netlify.
# (Se o site não estiver hospedado no Netlify, este arquivo é ignorado sem
# nenhum efeito; use vercel.json para Vercel, ou configure o servidor/CDN
# equivalente. Ver README.md para detalhes, inclusive a limitação do
# GitHub Pages, que não suporta cabeçalhos HTTP customizados.)
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' https://cdnjs.cloudflare.com https://cdn.jsdelivr.net; style-src 'self' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https://*.supabase.co; connect-src 'self' https://*.supabase.co; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  Cross-Origin-Resource-Policy: same-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
